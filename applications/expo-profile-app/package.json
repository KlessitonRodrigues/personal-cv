{
  "name": "@applications/expo-profile-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "android-build": "eas build -p android --profile preview",
    "android-build-local": "eas build -p android --profile development --local",
    "start-container": "docker-compose up -d --build",
    "stop-container": "docker-compose down",
    "build-container": "docker exec -it eas-local-builder bash -c 'eas build -p android --profile development --local'"
  },
  "dependencies": {
    "expo": "^57.0.2",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "expo-dev-client": "~57.0.5",
    "expo-status-bar": "^57.0.0",
    "react-native-webview": "14.0.1"
  }
}
